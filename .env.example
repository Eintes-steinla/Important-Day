# Sao chép file này thành .env trong từng app (apps/web/.env, apps/mobile/.env)
# CHỈ dùng khóa công khai ở client: publishable key (sb_publishable_...) hoặc anon key (JWT cũ). KHÔNG BAO GIỜ đưa service_role key vào web/mobile.

# --- Web (Vite) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# --- Mobile (Expo) ---
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
